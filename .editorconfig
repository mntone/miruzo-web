root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{css,html,json}]
indent_style = tab

[*.{cjs,js,jsx,mjs,ts,tsx}]
indent_style = tab

[*.md]
indent_style = space
trim_trailing_whitespace = false
max_line_length = 80

[package.json]
indent_style = space
indent_size = 2
